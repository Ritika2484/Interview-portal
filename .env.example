# Local development only. Copy to .env; never commit real credentials.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-random-local-key-before-running
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO
DJANGO_ENABLE_API_DOCS=true
# Leave empty for same-origin clients. A future local React server may use these:
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=interview_platform
POSTGRES_USER=interview
POSTGRES_PASSWORD=replace-with-a-random-local-database-password
# Host-process URLs. Compose overrides hosts/ports for container networking.
DATABASE_URL=postgresql://interview:replace-with-a-random-local-database-password@127.0.0.1:5432/interview_platform
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
AUTH_PUBLIC_BASE_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=no-reply@example.invalid
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
# Production: inject environment via a secret manager; .env is not auto-loaded.
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DATABASE_SSLMODE=verify-full
# PGSSLROOTCERT=/run/secrets/database-ca.pem
# DJANGO_TRUST_PROXY_SSL_HEADER=false
# AUTH_PUBLIC_BASE_URL=https://app.example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=no-reply@example.com
# EMAIL_HOST_USER=inject-from-secret-manager
# EMAIL_HOST_PASSWORD=inject-from-secret-manager

